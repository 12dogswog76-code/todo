{
  "name": "alextask",
  "short_name": "alextask",
  "description": "Задачи, деньги, ZZZ и справочник NTE — в одном приложении",
  "lang": "ru",
  "id": "/app.html",
  "start_url": "/app.html",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "background_color": "#08090c",
  "theme_color": "#08090c",
  "icons": [
    {
      "src": "img/app/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "img/app/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "img/app/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "img/app/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "ZZZ",
      "url": "/zzz.html",
      "icons": [
        {
          "src": "img/zzz/ui/icon-zzz-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "NTE — справочник",
      "url": "/nte/",
      "icons": [
        {
          "src": "nte/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Endfield — справочник",
      "url": "/ef/",
      "icons": [
        {
          "src": "ef/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Мои дела",
      "url": "/index.html",
      "icons": [
        {
          "src": "img/app/dela-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Мои деньги",
      "url": "/money.html",
      "icons": [
        {
          "src": "img/app/dengi-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}
